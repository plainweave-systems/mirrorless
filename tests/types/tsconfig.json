{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./*.ts", "../core/*.types.ts", "../dom/*.ts", "../../src/**/*.d.ts"]
}
