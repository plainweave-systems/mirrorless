{
  "name": "mirrorless",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Plainweave Systems",
  "description": "Server data as component input, not client-owned application state.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainweave-systems/mirrorless.git"
  },
  "homepage": "https://github.com/plainweave-systems/mirrorless#readme",
  "bugs": {
    "url": "https://github.com/plainweave-systems/mirrorless/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./src/core/index.js",
  "types": "./src/core/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.js",
      "default": "./src/core/index.js"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "import": "./src/react/index.js",
      "default": "./src/react/index.js"
    },
    "./preact": {
      "types": "./src/preact/index.d.ts",
      "import": "./src/preact/index.js",
      "default": "./src/preact/index.js"
    },
    "./vue": {
      "types": "./src/vue/index.d.ts",
      "import": "./src/vue/index.js",
      "default": "./src/vue/index.js"
    },
    "./svelte": {
      "types": "./src/svelte/index.d.ts",
      "svelte": "./src/svelte/index.js",
      "import": "./src/svelte/index.js",
      "default": "./src/svelte/index.js"
    },
    "./solid": {
      "types": "./src/solid/index.d.ts",
      "import": "./src/solid/index.js",
      "default": "./src/solid/index.js"
    },
    "./angular": {
      "types": "./src/angular/index.d.ts",
      "import": "./src/angular/index.js",
      "default": "./src/angular/index.js"
    },
    "./lit": {
      "types": "./src/lit/index.d.ts",
      "import": "./src/lit/index.js",
      "default": "./src/lit/index.js"
    },
    "./dom": {
      "types": "./src/dom/index.d.ts",
      "import": "./src/dom/index.js",
      "default": "./src/dom/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "examples/react",
    "examples/preact",
    "examples/vue",
    "examples/svelte",
    "examples/solid",
    "examples/angular",
    "examples/lit",
    "examples/vanilla"
  ],
  "scripts": {
    "test": "npm run test:core && npm run test:dom && npm run test:examples",
    "test:core": "node --test tests/core/*.test.js",
    "test:dom": "node --test tests/dom/*.test.js",
    "test:examples": "node --test tests/examples/*.test.js",
    "test:frameworks": "vitest run",
    "typecheck": "tsc -p tests/types/tsconfig.json",
    "check": "npm test && npm run test:frameworks && npm run typecheck && npm run typecheck:examples && npm run build:examples && npm run check:docs && npm run check:package",
    "typecheck:examples": "npm run typecheck --workspaces --if-present && npm run check --workspace examples/svelte",
    "build:examples": "npm run build --workspaces --if-present",
    "check:docs": "node scripts/check-docs.js",
    "check:package": "node scripts/check-package.js && node scripts/smoke-package.js",
    "prepublishOnly": "npm run check",
    "demo:server": "node examples/servers/node/server.js",
    "demo:vanilla": "npm run dev --workspace examples/vanilla",
    "demo:react": "npm run dev --workspace examples/react",
    "demo:preact": "npm run dev --workspace examples/preact",
    "demo:vue": "npm run dev --workspace examples/vue",
    "demo:svelte": "npm run dev --workspace examples/svelte",
    "demo:solid": "npm run dev --workspace examples/solid",
    "demo:angular": "npm run dev --workspace examples/angular",
    "demo:lit": "npm run dev --workspace examples/lit",
    "demo:typescript": "node examples/typescript/main.ts",
    "demo:clojurescript": "nbb examples/clojurescript/main.cljs"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "lit": ">=3.0.0",
    "preact": ">=10.24.0",
    "react": ">=18.0.0",
    "solid-js": ">=1.8.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "overrides": {
    "@angular/build": { "vite": "^8.3.5" }
  },
  "devDependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/build": "~22.2.4",
    "@angular/cli": "~22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "~22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/server-renderer": "^3.5.44",
    "jsdom": "^30.1.3",
    "lit": "^3.3.3",
    "nbb": "^1.6.214",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "zone.js": "^0.16.3"
  }
}
