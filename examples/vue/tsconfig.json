{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "skipLibCheck": false
  },
  "include": ["*.ts", "*.vue", "../shared/task-api.d.ts"]
}
